{
  "name": "tinyagent/sdk",
  "description": "Native agent core, streaming providers, sessions, JSONL RPC, and HTTP for TinyAgent.",
  "version": "0.0.1",
  "type": "library",
  "license": "MIT",
  "authors": [{ "name": "Radian Labs" }],
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "react/http": "1.11.1",
    "react/stream": "1.4.0",
    "react/socket": "1.17.0",
    "react/event-loop": "1.6.0",
    "react/promise": "3.3.0",
    "evenement/evenement": "3.0.2",
    "psr/http-message": "1.1",
    "opis/json-schema": "2.6.0"
  },
  "autoload": {
    "files": ["autoload.php"],
    "classmap": ["src/HttpConnection.php", "src/HttpListener.php"]
  },
  "suggest": {
    "ext-pcntl": "Required for native RPC, HTTP serving, and coding CLI interrupt cleanup."
  },
  "archive": {
    "exclude": ["/tests", "/tiny_agent.php", "/check.php", "/package.php", "/dist"]
  }
}
