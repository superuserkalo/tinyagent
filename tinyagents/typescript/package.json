{
  "name": "tiny-agent-sdk",
  "version": "0.0.1",
  "description": "A small agent SDK: validated tools, streaming, cancellation, durable sessions, resume, and compaction",
  "keywords": ["agent", "llm", "tools", "openai", "anthropic"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superuserkalo/tinyagent.git",
    "directory": "tinyagents/typescript"
  },
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "examples"
  ],
  "main": "./dist/tiny_agent.js",
  "types": "./dist/tiny_agent.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tiny_agent.d.ts",
      "default": "./dist/tiny_agent.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tinyagent": "./dist/tiny_agent.js"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "prepack": "npm run build",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test *.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
