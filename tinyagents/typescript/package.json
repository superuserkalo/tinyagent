{
  "name": "tiny-agent-sdk",
  "version": "0.2.0",
  "description": "A small agent SDK: validated tools, streaming, cancellation, durable sessions, resume, and compaction",
  "keywords": [
    "agent",
    "llm",
    "tools",
    "openai",
    "anthropic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superuserkalo/tinyagent.git",
    "directory": "tinyagents/typescript"
  },
  "type": "module",
  "files": [
    "dist",
    "examples"
  ],
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tinyagent": "./dist/tiny_agent.js"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "prepack": "npm run build",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test *.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
